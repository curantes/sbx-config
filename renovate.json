{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Images pinned by digest in Dockerfile ARGs",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker)\\s+ARG \\w+=(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Versions in Dockerfile ARGs",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags|github-releases) depName=(?<depName>\\S+)\\s+ARG \\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Git branch heads pinned by commit in Dockerfile ARGs",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) branch=(?<currentValue>\\S+)\\s+ARG \\w+=(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "The base image is tracked by the custom manager; avoid a duplicate PR from the built-in Dockerfile manager",
      "matchManagers": [
        "dockerfile"
      ],
      "matchDepNames": [
        "docker.io/docker/sandbox-templates"
      ],
      "enabled": false
    },
    {
      "description": "nixpkgs-unstable moves several times a day: one PR a week, merged when CI passes",
      "matchDepNames": [
        "nixpkgs"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": true
    },
    {
      "description": "Base image digest bumps: weekly, merged when CI passes",
      "matchDepNames": [
        "docker.io/docker/sandbox-templates"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "automerge": true
    },
    {
      "description": "GitHub Actions digest/minor bumps are low risk",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
